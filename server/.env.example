# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas in Production, Local in Dev)
# Local: mongodb://127.0.0.1:27017/task_management_db
# Production: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/task_management_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/task_management_db

# Client Application URL (Permitted CORS Origin on Render)
# Local: http://localhost:5173
# Production: https://your-taskpulse-app.vercel.app
CLIENT_URL=http://localhost:5173

# Authentication Secrets (Must be a secure 32+ character random secret in production)
JWT_SECRET=your_jwt_secret_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# Email Notification Service (SMTP)
# For local dev / testing: leave credentials empty or dummy to use mock transporter
# For production (Gmail, SendGrid, Mailgun, Brevo):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_verified_account@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM="TaskPulse Enterprise" <noreply@taskpulse.com>
